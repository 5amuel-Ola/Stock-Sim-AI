# This workspace root is not the runtime boundary for either app.
# Put backend secrets in financial-ai-backend/.env and frontend variables in financial-ai-frontend/.env.local.

# Backend secrets and server configuration live in financial-ai-backend/.env
OPENAI_API_KEY=your-openai-api-key
GOOGLE_GEMINI_API_KEY=your-google-gemini-api-key
ALPACA_KEY=
ALPACA_SECRET=
JWT_SECRET=change-me-to-a-random-32-plus-char-secret
DATABASE_URL=postgresql://user:password@localhost:5432/financial_ai
FRONTEND_URL=http://localhost:3002

# Frontend public runtime configuration lives in financial-ai-frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1