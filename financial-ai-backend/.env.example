# Database (Neon, Supabase, or local PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/financial_ai

# Auth (must be at least 32 characters)
JWT_SECRET=change-me-to-a-random-32-plus-char-secret

# Google Gemini AI (https://aistudio.google.com/app/apikey)
GOOGLE_GEMINI_API_KEY=your-google-gemini-api-key

# OpenAI — used for risk analysis, trend analysis, and investment suggestion agents
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# Optional stock-price fallback via Alpaca Market Data
# https://app.alpaca.markets/signup
ALPACA_KEY=
ALPACA_SECRET=

# Stock prices: Yahoo Finance (public, no API key required)
# Crypto prices: Gemini Exchange (public, no API key required)

# Server
PORT=8080
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
